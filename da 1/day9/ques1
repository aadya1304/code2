//Write a program to find the roots of a quadratic equation and categorize them.
#include <stdio.h>
#include <math.h>

int main()
{
    int a, b, c;
    int D, root1, root2;

    scanf("%d %d %d", &a, &b, &c);

    D = b * b - 4 * a * c;

    if (D > 0)
    {
        root1 = (-b + sqrt(D)) / (2 * a);
        root2 = (-b - sqrt(D)) / (2 * a);

        printf("Roots are real and different: %d, %d", root1, root2);
    }
    else if (D == 0)
    {
        root1 = -b / (2 * a);

        printf("Roots are real and same: %d", root1);
    }
    else
    {
        printf("Roots are complex");
    }

    return 0;
}