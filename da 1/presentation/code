#include <stdio.h>

int main()
{
    int choice, item, quantity, i;
    char again;

    /* price of all 28 items */
    int price[28] = {
        /* Snacks: index 0-5 */
        80, 60, 90, 150, 100, 80,

        /* Starters: index 6-10 */
        180, 140, 100, 90, 120,

        /* Main Course: index 11-19 */
        180, 200, 160, 180, 250, 180, 220, 40, 50,

        /* Desserts: index 20-24 */
        60, 70, 80, 120, 120,

        /* Chef's Special: index 25-26 */
        100, 120
    };

    int qty[28] = {0};
    int total[28] = {0};
    int subtotal = 0;
    int discount = 0;
    int finalAmount;


    while (1)
    {
        printf("\n\n===== SMART CANTEEN =====");
        printf("\n1. Snacks");
        printf("\n2. Starters");
        printf("\n3. Main Course");
        printf("\n4. Desserts");
        printf("\n5. Chef's Special");

        printf("\n\nEnter category: ");
        scanf("%d", &choice);


/* Display items of choosen category*/

       switch (choice){
    
           case 1:
printf("\n----- SNACKS -----");
printf("\n1. Momos - Rs.40");
printf("\n2. Cutlet - Rs.60");
printf("\n3. Spring Roll - Rs.90");
printf("\n4. Fish Tikka - Rs.150");
printf("\n5. Quick Bites Paneer - Rs.100");
printf("\n6. Egg Frankie - Rs.80");
break;


    case 2:
printf("\n----- STARTERS -----");
printf("\n1. Kebabs - Rs.180");
printf("\n2. Veg Manchurian - Rs.140");
printf("\n3. Hot and Sour Soup - Rs.100");
printf("\n4. Corn Soup - Rs.90");
printf("\n5. Crunchy Corns - Rs.120");
break;


    case 3:
printf("\n----- MAIN COURSE -----");
printf("\n1. Chilli Paneer - Rs.180");
printf("\n2. Kadhai Paneer - Rs.200");
printf("\n3. Malai Chap - Rs.160");
printf("\n4. Afgani Chap - Rs.180");
printf("\n5. Chicken Schezwan - Rs.250");
printf("\n6. Veg Biryani - Rs.180");
printf("\n7. Non Veg Biryani - Rs.220");
printf("\n8. Garlic Naan - Rs.40");
printf("\n9. Lacha Paratha - Rs.50");
break;


    case 4:
printf("\n----- DESSERTS -----");
printf("\n1. Vanilla Ice Cream - Rs.60");
printf("\n2. Chocolate Ice Cream - Rs.70");
printf("\n3. Rasmalai - Rs.80");
printf("\n4. Blueberry Milkshake - Rs.120");
printf("\n5. Chocolate Shake - Rs.120");
break;


    case 5:
printf("\n----- CHEF'S SPECIAL -----");
printf("\n1. Quick Bites Paneer - Rs.100");
printf("\n2. Quick Bites Chicken - Rs.120");
break;


default:
printf("\nInvalid category!");
                continue;
        }


        /* TAKE ITEM NUMBER */

        printf("\n\nEnter item number: ");
        scanf("%d", &item);


        /*
           Convert category item number into
           its position in the arrays.
        */

        if (choice == 1 && item >= 1 && item <= 6)
        {
            i = item - 1;
        }

        else if (choice == 2 && item >= 1 && item <= 5)
        {
            i = item + 5;
        }

        else if (choice == 3 && item >= 1 && item <= 9)
        {
            i = item + 10;
        }

        else if (choice == 4 && item >= 1 && item <= 5)
        {
            i = item + 19;
        }

        else if (choice == 5 && item >= 1 && item <= 2)
        {
            i = item + 24;
        }

        else
        {
            printf("\nInvalid item!");
            continue;
        }


        /* TAKE QUANTITY */

        printf("Enter quantity: ");
        scanf("%d", &quantity);


        if (quantity > 0)
        {
            qty[i] = qty[i] + quantity;

            total[i] = qty[i] * price[i];

            printf("\nItem added successfully!");
        }

        else
        {
            printf("\nInvalid quantity!");
            continue;
        }


        /* ASK IF CUSTOMER WANTS TO ORDER MORE */

        printf("\n\nDo you want to order something else? (Y/N): ");
        scanf(" %c", &again);


        if (again == 'N' || again == 'n')
        {
            break;
        }
    }


    /* GENERATE FINAL BILL */

    printf("\n\n==============================");
    printf("\n          FINAL BILL");
    printf("\n==============================\n");


    for (i = 0; i < 28; i++)
    {
        if (qty[i] > 0)
        {
            printf("\nItem number: %d", i + 1);
            printf("\nQuantity: %d", qty[i]);
            printf("\nPrice: Rs.%d", price[i]);
            printf("\nTotal: Rs.%d", total[i]);
            printf("\n------------------------------");

            subtotal = subtotal + total[i];
        }
    }


    /* CALCULATE DISCOUNT */

    printf("\n\nSubtotal = Rs.%d", subtotal);

   if (subtotal >= 2000)
{
    discount = subtotal * 25 / 100;
}
else if (subtotal >= 1000)
{
    discount = subtotal * 15 / 100;
}
else if (subtotal >= 500)
{
    discount = subtotal * 10 / 100;
}
else
{
    discount = 0;
}

    finalAmount = subtotal - discount;


    printf("\nDiscount = Rs.%d", discount);
    printf("\nFinal Amount = Rs.%d", finalAmount);


    printf("\n\n==============================");
    printf("\n   Thank you for visiting!");
    printf("\n==============================\n");


    return 0;
}