//Check if a string is a palindrome.
#include <stdio.h>

int main() {
    char str[100];
    int i = 0, j, flag = 1;

    printf("Enter a string: ");
    scanf("%s", str);

    // Find length of string
    while (str[i] != '\0') {
        i++;
    }

    j = i - 1;
    i = 0;

    // Compare characters
    while (i < j) {
        if (str[i] != str[j]) {
            flag = 0;
            break;
        }
        i++;
        j--;
    }

    if (flag == 1)
        printf("String is a palindrome.\n");
    else
        printf("String is not a palindrome.\n");

    return 0;
}
