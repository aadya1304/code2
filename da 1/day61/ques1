//rite a program to take an integer array arr and an integer k as inputs. The task is to find the first negative integer in each subarray of size k moving from left to right. If no negative exists in a window, print "0" for that window. Print the results separated by spaces as output.
#include <stdio.h>

int main()
{
    int arr[100], n, k, i, j, first;

    printf("Enter the size of array: ");
    scanf("%d", &n);

    printf("Enter the array elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Enter the value of k: ");
    scanf("%d", &k);

    if(k <= 0 || k > n)
    {
        printf("Invalid value of k");
        return 0;
    }

    for(i = 0; i <= n - k; i++)
    {
        first = 0;

        for(j = i; j < i + k; j++)
        {
            if(arr[j] < 0)
            {
                first = arr[j];
                break;
            }
        }

        printf("%d ", first);
    }

    return 0;
}