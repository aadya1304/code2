//Write a program to print the following pattern:

*

*
*
*

*
*
*
*
*

*
*
*

*//

#include <stdio.h>

int main()
{
    int i, j;

    for(i = 1; i <= 4; i++)
    {
        for(j = 1; j <= 4; j++)
        {
            printf("*");
        }
        printf("\n");
    }

    printf("\n");

    for(i = 1; i <= 5; i++)
    {
        printf("*");
    }

    printf("\n\n");

    for(i = 1; i <= 3; i++)
    {
        printf("*");
    }

    printf("\n\n");

    printf("*");

    return 0;
}